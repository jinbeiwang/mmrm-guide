  "cards": [
    {
      "dot": "emerald",
      "title": "语句决定打开哪张表",
      "items": [
        "LSMEANS ... / DIFF 同时产生 LSMeans 与 Diffs 两张表",
        "LSMESTIMATE 产生 LSMEstimates，与 Diffs 是并列关系而非替代",
        "SLICE 既可作为 LSMEANS 的选项，也可作为独立语句"
      ]
    },
    {
      "dot": "cyan",
      "title": "STORE 存的是模型不是表",
      "items": [
        "Item Store 保存设计矩阵、β̂、V̂ 与协方差参数估计",
        "PROC PLM RESTORE 后可直接追加 ESTIMATE / LSMESTIMATE",
        "适合需要在同一个模型上回答多个新问题的场景"
      ]
    },
    {
      "dot": "rose",
      "title": "只在显示层四舍五入",
      "items": [
        "ODS 导出数据集必须保留完整数值精度",
        "治疗差值由模型直接估计，不能用取整后的 LSMean 相减",
        "SE、DF、置信区间同样必须来自模型输出"
      ]
    }
  ]
